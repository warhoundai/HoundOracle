FROM python@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
WORKDIR /opt/oracle
# Open-source local OCR binary and English data; no paid solver service.
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-cache-dir '.[api,mcp,captcha]' && useradd --uid 10001 --create-home oracle && mkdir /data && chown oracle:oracle /data
USER 10001
VOLUME /data
EXPOSE 8083
ENTRYPOINT ["python", "-m", "houndoracle", "--database", "/data/oracle.sqlite"]
CMD ["--captcha", "serve", "--host", "0.0.0.0", "--port", "8083"]
